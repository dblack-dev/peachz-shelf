rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// All user data is strictly isolated under /users/{userId}/...
// Access is strictly restricted to the single sole-owner account:
//   - Email: dew.blackdevil@gmail.com
//   - UID:   b1nmd1qyK0bd48iLLiBGMF3mtCi1
// No public, multi-user, or cross-user read/write access is permitted.
// Ownership is derived solely from the authenticated Firebase Auth UID
// matching both the sole-owner UID and {userId} (no client-supplied uid/role fields are trusted).
//
// 1. Collection: users/{userId}/sync/{docId}
//    (Preserved for existing apps: Peachz Haus Studio, noveltransstudio, pomehelpmami)
//    Fields (all required):
//      - stateJson: string (<= 1,000,000 chars) - serialized app sync payload
//      - updatedAt: number - epoch timestamp in milliseconds
//      - updatedBy: string (<= 128 chars) - client/app identifier
//
// 2. Collection: users/{userId}/readerNovels/{novelId}
//    Fields:
//      - title: string (required, 1..200 chars)
//      - translatedTitle: string (optional, <= 200 chars)
//      - status: string (required, enum: 'reading' | 'completed' | 'plan')
//      - isFavorite: bool (required)
//      - chapterCount: number (required, 0..1,000,000)
//      - createdAt: number (required, immutable after creation, 0..9,999,999,999,999)
//      - updatedAt: number (required, 0..9,999,999,999,999)
//      - author: string (optional, <= 120 chars)
//      - coverUrl: string (optional, <= 200,000 chars)
//      - synopsis: string (optional, <= 5,000 chars)
//      - translatedSynopsis: string (optional, <= 10,000 chars)
//      - tags: list<string> (optional, <= 20 items, each string <= 120 chars)
//      - notes: string (optional, <= 25,000 chars)
//      - glossary: string (optional, <= 50,000 chars)
//      - transStyle: string (optional, <= 1,000 chars)
//      - characterWiki: string (optional, <= 50,000 chars)
//      - storyRecap: string (optional, <= 30,000 chars)
//      - lastChapterId: string (optional, <= 128 chars)
//      - lastChapterTitle: string (optional, <= 200 chars)
//      - lastChapterOrder: number (optional, 0..1,000,000)
//      - lastScrollRatio: number (optional, 0..1)
//
// 3. Collection: users/{userId}/readerNovels/{novelId}/chapters/{chapterId}
//    Fields:
//      - order: number (required, 0..1,000,000)
//      - title: string (required, 1..200 chars)
//      - translatedTitle: string (optional, <= 200 chars)
//      - content: string (required, <= 800,000 chars)
//      - translatedContent: string (optional, <= 800,000 chars)
//      - wordCount: number (required, 0..2,000,000)
//      - note: string (optional, <= 20,000 chars)
//      - createdAt: number (required, immutable after creation, 0..9,999,999,999,999)
//      - updatedAt: number (required, 0..9,999,999,999,999)
//
// 4. Collection: users/{userId}/readerMeta/{docId}
//    Two mutually exclusive metadata schemas (strictly validated by required + allowed keys):
//
//    4a. Reader Preferences (e.g., docId = 'prefs'):
//      - theme: string (required, enum: 'light' | 'sepia' | 'dark')
//      - fontFamily: string (required, enum: 'sarabun' | 'noto' | 'prompt')
//      - fontSize: number (required, 12..36)
//      - lineHeight: number (required, 1.2..3.0)
//      - maxWidth: number (required, 480..1200)
//      - readLangMode: string (optional, enum: 'th' | 'orig' | 'dual')
//      - updatedAt: number (required, 0..9,999,999,999,999)
//
//    4b. Translator Config (e.g., docId = 'translator'):
//      - geminiApiKey: string (required, <= 500 chars)
//      - geminiModel: string (required, <= 200 chars)
//      - defaultStyle: string (required, <= 2,000 chars)
//      - activeKeyId: string (optional, <= 120 chars)
//      - activeKeyName: string (optional, <= 120 chars)
//      - savedKeysJson: string (optional, <= 50,000 chars)
//      - savedModelsJson: string (optional, <= 20,000 chars)
//      - thinkingLevel: string (optional, <= 50 chars)
//      - thinkingBudget: number (optional, 0..1,000,000)
//      - updatedAt: number (required, 0..9,999,999,999,999)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all paths unless explicitly matched and allowed below
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user is the sole owner and owns the path under /users/{userId}
    function isOwner(userId) {
      return isAuthenticated() &&
             request.auth.uid == 'b1nmd1qyK0bd48iLLiBGMF3mtCi1' &&
             request.auth.uid == userId;
    }

    // Enforce strict schema (no extraneous fields)
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // Enforce presence of all required fields
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Validate bounded epoch millisecond number (blocks negative, NaN, Infinity)
    function isValidEpochMs(val) {
      return val is number && val >= 0 && val <= 9999999999999;
    }

    // Validate optional bounded string field
    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    // Validate individual tag element if present at index
    function isValidTagItem(tags, idx) {
      return tags.size() <= idx || (tags[idx] is string && tags[idx].size() <= 120);
    }

    // Validate tags list (max 20 items, every element must be a bounded string)
    function isValidTagList(tags) {
      return tags is list &&
             tags.size() <= 20 &&
             isValidTagItem(tags, 0) && isValidTagItem(tags, 1) &&
             isValidTagItem(tags, 2) && isValidTagItem(tags, 3) &&
             isValidTagItem(tags, 4) && isValidTagItem(tags, 5) &&
             isValidTagItem(tags, 6) && isValidTagItem(tags, 7) &&
             isValidTagItem(tags, 8) && isValidTagItem(tags, 9) &&
             isValidTagItem(tags, 10) && isValidTagItem(tags, 11) &&
             isValidTagItem(tags, 12) && isValidTagItem(tags, 13) &&
             isValidTagItem(tags, 14) && isValidTagItem(tags, 15) &&
             isValidTagItem(tags, 16) && isValidTagItem(tags, 17) &&
             isValidTagItem(tags, 18) && isValidTagItem(tags, 19);
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    // Validator for existing sync docs (Peachz Haus Studio, noveltransstudio, pomehelpmami)
    function isValidSyncDoc(data) {
      return hasOnlyAllowedFields(data, ['stateJson', 'updatedAt', 'updatedBy']) &&
             hasRequiredFields(data, ['stateJson', 'updatedAt', 'updatedBy']) &&
             data.stateJson is string && data.stateJson.size() <= 1000000 &&
             data.updatedAt is number &&
             data.updatedBy is string && data.updatedBy.size() <= 128;
    }

    // Validator for Private Novel Reader novel metadata
    function isValidNovel(data) {
      return hasOnlyAllowedFields(data, [
               'title', 'translatedTitle', 'author', 'coverUrl', 'synopsis',
               'translatedSynopsis', 'tags', 'status', 'isFavorite', 'notes',
               'glossary', 'transStyle', 'characterWiki', 'storyRecap',
               'chapterCount', 'lastChapterId', 'lastChapterTitle',
               'lastChapterOrder', 'lastScrollRatio', 'createdAt', 'updatedAt'
             ]) &&
             hasRequiredFields(data, [
               'title', 'status', 'isFavorite', 'chapterCount', 'createdAt', 'updatedAt'
             ]) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             isValidOptionalString(data, 'translatedTitle', 200) &&
             data.status is string && data.status in ['reading', 'completed', 'plan'] &&
             data.isFavorite is bool &&
             data.chapterCount is number && data.chapterCount >= 0 && data.chapterCount <= 1000000 &&
             isValidEpochMs(data.createdAt) &&
             isValidEpochMs(data.updatedAt) &&
             isValidOptionalString(data, 'author', 120) &&
             isValidOptionalString(data, 'coverUrl', 200000) &&
             isValidOptionalString(data, 'synopsis', 5000) &&
             isValidOptionalString(data, 'translatedSynopsis', 10000) &&
             (!('tags' in data) || isValidTagList(data.tags)) &&
             isValidOptionalString(data, 'notes', 25000) &&
             isValidOptionalString(data, 'glossary', 50000) &&
             isValidOptionalString(data, 'transStyle', 1000) &&
             isValidOptionalString(data, 'characterWiki', 50000) &&
             isValidOptionalString(data, 'storyRecap', 30000) &&
             isValidOptionalString(data, 'lastChapterId', 128) &&
             isValidOptionalString(data, 'lastChapterTitle', 200) &&
             (!('lastChapterOrder' in data) || (data.lastChapterOrder is number && data.lastChapterOrder >= 0 && data.lastChapterOrder <= 1000000)) &&
             (!('lastScrollRatio' in data) || (data.lastScrollRatio is number && data.lastScrollRatio >= 0 && data.lastScrollRatio <= 1));
    }

    // Validator for Private Novel Reader chapter documents
    function isValidChapter(data) {
      return hasOnlyAllowedFields(data, [
               'order', 'title', 'translatedTitle', 'content', 'translatedContent',
               'wordCount', 'note', 'createdAt', 'updatedAt'
             ]) &&
             hasRequiredFields(data, [
               'order', 'title', 'content', 'wordCount', 'createdAt', 'updatedAt'
             ]) &&
             data.order is number && data.order >= 0 && data.order <= 1000000 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             isValidOptionalString(data, 'translatedTitle', 200) &&
             data.content is string && data.content.size() <= 800000 &&
             isValidOptionalString(data, 'translatedContent', 800000) &&
             data.wordCount is number && data.wordCount >= 0 && data.wordCount <= 2000000 &&
             isValidOptionalString(data, 'note', 20000) &&
             isValidEpochMs(data.createdAt) &&
             isValidEpochMs(data.updatedAt);
    }

    // Validator for Private Novel Reader user preferences
    function isValidReaderPrefs(data) {
      return hasOnlyAllowedFields(data, [
               'theme', 'fontFamily', 'fontSize', 'lineHeight', 'maxWidth',
               'readLangMode', 'updatedAt'
             ]) &&
             hasRequiredFields(data, [
               'theme', 'fontFamily', 'fontSize', 'lineHeight', 'maxWidth', 'updatedAt'
             ]) &&
             data.theme is string && data.theme in ['light', 'sepia', 'dark'] &&
             data.fontFamily is string && data.fontFamily in ['sarabun', 'noto', 'prompt'] &&
             data.fontSize is number && data.fontSize >= 12 && data.fontSize <= 36 &&
             data.lineHeight is number && data.lineHeight >= 1.2 && data.lineHeight <= 3.0 &&
             data.maxWidth is number && data.maxWidth >= 480 && data.maxWidth <= 1200 &&
             (!('readLangMode' in data) || (data.readLangMode is string && data.readLangMode in ['th', 'orig', 'dual'])) &&
             isValidEpochMs(data.updatedAt);
    }

    // Validator for Private Novel Reader translator configuration
    function isValidTranslatorConfig(data) {
      return hasOnlyAllowedFields(data, [
               'geminiApiKey', 'geminiModel', 'defaultStyle', 'activeKeyId',
               'activeKeyName', 'savedKeysJson', 'savedModelsJson',
               'thinkingLevel', 'thinkingBudget', 'updatedAt'
             ]) &&
             hasRequiredFields(data, ['geminiApiKey', 'geminiModel', 'defaultStyle', 'updatedAt']) &&
             data.geminiApiKey is string && data.geminiApiKey.size() <= 500 &&
             data.geminiModel is string && data.geminiModel.size() <= 200 &&
             data.defaultStyle is string && data.defaultStyle.size() <= 2000 &&
             isValidOptionalString(data, 'activeKeyId', 120) &&
             isValidOptionalString(data, 'activeKeyName', 120) &&
             isValidOptionalString(data, 'savedKeysJson', 50000) &&
             isValidOptionalString(data, 'savedModelsJson', 20000) &&
             isValidOptionalString(data, 'thinkingLevel', 50) &&
             (!('thinkingBudget' in data) || (data.thinkingBudget is number && data.thinkingBudget >= 0 && data.thinkingBudget <= 1000000)) &&
             isValidEpochMs(data.updatedAt);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Existing apps sync documents (preserved without breaking legacy clients)
    match /users/{userId}/sync/{docId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidSyncDoc(request.resource.data);
    }

    // Private Novel Reader: Novel shelf items
    match /users/{userId}/readerNovels/{novelId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && isValidNovel(request.resource.data);
      allow update: if isOwner(userId) &&
                       isValidNovel(request.resource.data) &&
                       request.resource.data.createdAt == resource.data.createdAt;
    }

    // Private Novel Reader: Novel chapters
    match /users/{userId}/readerNovels/{novelId}/chapters/{chapterId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && isValidChapter(request.resource.data);
      allow update: if isOwner(userId) &&
                       isValidChapter(request.resource.data) &&
                       request.resource.data.createdAt == resource.data.createdAt;
    }

    // Private Novel Reader: Cloud reading preferences & translator configuration
    match /users/{userId}/readerMeta/{docId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
                               (isValidReaderPrefs(request.resource.data) ||
                                isValidTranslatorConfig(request.resource.data));
    }
  }
}
